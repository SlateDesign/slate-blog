---
import { getCollection } from 'astro:content';
import i18next from '@/i18n';
import Search from '@/components/search';
import PageLayout from '@/components/layouts/PageLayout.astro';
import TagFilterPosts from '@/components/tag-filter-posts';
// import Button from '@/components/button';
import slateConfig from '~@/slate.config';

const postCollection = await getCollection('post', ({ data }) => {
  return data.draft !== true;
});

const tagCounts = postCollection.reduce<Record<string, number>>((res, post) => {
  const postTags = post.data.tags;
  if (!postTags || !postTags.length) return res;
  postTags.forEach((tag) => {
    if (tag.trim() === '') return;

    if (res[tag]) {
      res[tag]++;
    } else {
      res[tag] = 1;
    }
  });
  return res;
}, {});

const tags = [
  { name: i18next.t('common.all'), count: postCollection.length },
  ...Object.keys(tagCounts).map((tag) => ({
    name: tag,
    count: tagCounts[tag],
  })),
];

const posts = [...postCollection]
  .sort((a, b) => b.data.pubDate!.getTime() - a.data.pubDate!.getTime())
  .map((post) => ({
    url: `/blog/${post.slug}`,
    title: post.data.title,
    pubDate: post.data.pubDate?.toISOString() ?? '',
    tags: post.data.tags,
  }));
---

<PageLayout>
  <section class="relative mb-16">
    <h3 class="text-slate12 text-[40px] leading-tight font-semibold">
      {slateConfig.title}
    </h3>
    <p class="text-slate10 text-xl">{slateConfig.description}</p>
    <Search
      client:only="react"
      className="absolute top-1/2 right-0 -translate-y-1/2"
    />
  </section>

  <TagFilterPosts
    client:load
    posts={posts}
    tags={tags}
    emptyState={i18next.t('common.noPostsForTag')}
    lang={slateConfig.lang ?? 'zh-CN'}
  />
</PageLayout>
